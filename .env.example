# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
WEBHOOK_HARD_DEADLINE_SECONDS=8.5
DATA_DIR=/app/data
SOURCE_SNAPSHOT_VERSION=assignment-export-v1

# PostgreSQL (development defaults; use secrets outside local development)
POSTGRES_DB=quickdrop
POSTGRES_USER=quickdrop
POSTGRES_PASSWORD=quickdrop_dev
DATABASE_URL=postgresql+psycopg://quickdrop:quickdrop_dev@postgres:5432/quickdrop

# LLM / Groq (auto uses Groq when GROQ_API_KEY is set, otherwise deterministic parser; groq requires key; fake forces offline parser)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=4
LLM_MAX_RETRIES=1
MODEL_PROMPT_PATH=project-analysis/STRICT_RULES_SYSTEM_PROMPT.v2.md
MODEL_SCHEMA_PATH=contracts/model_interpretation.v2.schema.json
RUNTIME_SCHEMA_PATH=project-analysis/response_classification.v2.schema.json
MODEL_FALLBACK_ENABLED=true
MESSAGE_MAX_LENGTH=4000

# Versioned contracts
POLICY_VERSION=payout-policy-v1
NORMALIZATION_VERSION=source-normalization-v1
ACTIVE_PROMPT_VERSION=strict-rules-v2
ACTIVE_MODEL_SCHEMA_VERSION=2.0.0
ACTIVE_RUNTIME_SCHEMA_VERSION=2.0.0

# PaySwift
PAYSWIFT_BASE_URL=http://payswift:8081
PAYSWIFT_CONNECT_TIMEOUT_SECONDS=1
PAYSWIFT_READ_TIMEOUT_SECONDS=4
PAYSWIFT_MAX_RETRY_ATTEMPTS=6
PAYSWIFT_RETRY_BASE_SECONDS=0.5
PAYSWIFT_RETRY_MAX_SECONDS=30

# Worker
WORKER_POLL_INTERVAL_SECONDS=0.25
WORKER_JOB_LEASE_SECONDS=30
WORKER_BATCH_SIZE=10
WORKER_HEARTBEAT_INTERVAL_SECONDS=1
ACTIVE_WORKER_HEARTBEAT_TTL_SECONDS=20
